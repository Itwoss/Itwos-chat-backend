NODE_ENV=development
PORT=5001
MONGODB_URI=your_mongodb_connection_string

# Optional: DigitalOcean Managed Redis (rediss://...) — required before running 2+ Node instances behind a load balancer
# REDIS_URL=
JWT_SECRET=your_jwt_secret
FRONTEND_URL=http://localhost:5173
# Used by /open/post/:id redirect + OG canonical (falls back to FRONTEND_URL)
FRONTEND_WEB_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001

# Media storage: Cloudflare R2 only (S3-compatible API). Required for uploads and deletes.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# Public URL base (custom domain or R2 public bucket URL), no trailing slash
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
# Browser direct PUT: add CORS on the bucket for your frontend origin (PUT, OPTIONS, Content-Type).

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
YOUTUBE_API_KEY=your_youtube_api_key
ENCRYPTION_KEY=your_encryption_key

# Google Sign-In — must match VITE_GOOGLE_CLIENT_ID on the frontend (Web OAuth client ID).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Optional: comma-separated extra client IDs if tokens can be minted by another OAuth client in the same project
# GOOGLE_CLIENT_IDS=

# LiveKit Cloud — DM voice/video call tokens (from https://cloud.livekit.io/)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
